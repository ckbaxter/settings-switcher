# Einstellungen und Zugangsdaten für den Runner (run.sh).
# Kopieren nach runner.env und mit chmod 600 schützen. Nicht ins Repo einchecken.
# Format für docker --env-file: KEY=Wert, keine Anführungszeichen, keine Leerzeichen um das =.

# Webseiten, die der BROWSER besuchen darf (die Fritzbox), kommagetrennt, nur Hostname/IP ohne http:// und Port.
# Alles andere wird blockiert. Hat nichts mit EDITOR_ALLOWED_HOSTS aus .env zu tun.
# Besser die IP als fritz.box verwenden: im Container wird fritz.box oft nicht aufgelöst.
SWITCHER_ALLOWED_HOSTS=192.168.178.1

# Zugangsdaten, im Profil nur als ${SWITCHER_USER} / ${SWITCHER_PASSWORD} bei "fill" benutzbar.
# Eigenen Fritzbox-Benutzer mit minimalen Rechten anlegen, ohne Zugriff aus dem Internet.
SWITCHER_USER=
SWITCHER_PASSWORD=

# Optional
# SWITCHER_IGNORE_HTTPS_ERRORS=1    # nur nötig, wenn base_url https:// mit dem Fritzbox-Zertifikat ist
# SWITCHER_MAX_RUNTIME_S=120        # harte Zeitgrenze pro Lauf
# SWITCHER_CHROMIUM_NO_SANDBOX=0    # Standard ist 1, weil der Container selbst die Sandbox ist (siehe README)
# SWITCHER_DOCKER_NETWORK=          # eigenes Docker-Netz für den Runner
