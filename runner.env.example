# Einstellungen und Zugangsdaten für den Runner (run.sh).
# Kopieren nach runner.env und mit chmod 600 schützen. Nicht ins Repo einchecken.
# Format für docker --env-file: KEY=Wert, keine Anführungszeichen, keine Leerzeichen um das =.

# Erlaubte Hosts, kommagetrennt. Alles andere wird vom Browser blockiert.
# Besser die IP als fritz.box verwenden: im Container wird fritz.box oft nicht aufgelöst.
SS_ALLOWED_HOSTS=192.168.178.1

# Zugangsdaten, im Profil nur als ${SS_USER} / ${SS_PASSWORD} bei "fill" benutzbar.
# Eigenen Fritzbox-Benutzer mit minimalen Rechten anlegen, ohne Zugriff aus dem Internet.
SS_USER=
SS_PASSWORD=

# Optional
# SS_IGNORE_HTTPS_ERRORS=1    # nur nötig, wenn base_url https:// mit dem Fritzbox-Zertifikat ist
# SS_MAX_RUNTIME_S=120        # harte Zeitgrenze pro Lauf
# SS_CHROMIUM_NO_SANDBOX=0    # Standard ist 1, weil der Container selbst die Sandbox ist (siehe README)
# SS_DOCKER_NETWORK=          # eigenes Docker-Netz für den Runner
