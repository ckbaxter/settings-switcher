# Nur für docker compose (Profil-Editor und Live-Recorder). Kopieren nach .env, chmod 600.
# Token erzeugen:  openssl rand -hex 24
EDITOR_TOKEN=

# Host-UID/GID, damit der Editor in ./profiles schreiben darf (id -u / id -g)
SWITCHER_UID=1000
SWITCHER_GID=1000

# Zugriff auf den EDITOR (nicht auf die Fritzbox):
# EDITOR_BIND          auf welcher Netzwerkschnittstelle des Docker-Hosts der Port offen ist
#                      (127.0.0.1 = nur lokal, 0.0.0.0 = auch im LAN)
# EDITOR_ALLOWED_HOSTS Namen/IPs, unter denen der Editor aufgerufen werden darf: genau das, was du in die
#                      Browser-Adresszeile tippst, ohne http:// und ohne Port. Nicht die Adresse deines
#                      Endgeräts. Bei Zugriff aus dem LAN den Namen oder die IP des Docker-Hosts ergänzen.
# EDITOR_ALLOWED_IPS   Von welchen Adressen der Editor erreichbar ist: IPs oder CIDR-Netze, kommagetrennt
#                      (z. B. die Adresse deines Reverse Proxys / Nginx Proxy Managers). Leer = keine
#                      Einschränkung. Geprüft wird die direkte Gegenstelle der Verbindung, nie
#                      X-Forwarded-For. Aus der Sicht des Containers ist das die Adresse, mit der der Proxy
#                      ankommt (siehe docs/konfiguration.md, "Zugriff auf bestimmte IPs begrenzen"). Ungültiger Eintrag = Start bricht ab.
# Für LAN-Zugriff lieber Reverse Proxy mit TLS davorsetzen, sonst geht das Token im Klartext über das Netz.
# Nach Änderungen: docker compose ... up -d (Neustart allein liest .env nicht neu).
# EDITOR_BIND=127.0.0.1
# EDITOR_PORT=8080
# EDITOR_ALLOWED_HOSTS=localhost,127.0.0.1
# EDITOR_ALLOWED_IPS=

# Nur für den Live-Recorder (docker compose --profile record): welche Webseiten der BROWSER besuchen darf,
# also die Fritzbox. Nur Hostname/IP, ohne http:// und Port. Gleicher Wert wie in runner.env.
# Hat nichts mit EDITOR_ALLOWED_HOSTS zu tun. Zugangsdaten gehören hier NICHT hinein.
SWITCHER_ALLOWED_HOSTS=192.168.178.1
# SWITCHER_IGNORE_HTTPS_ERRORS=0    # 1 nur bei https:// mit dem Fritzbox-Zertifikat
# REC_MAX_SECONDS=600               # harte Obergrenze einer Aufnahme
# REC_IDLE_SECONDS=180              # Aufnahme endet nach so langer Untätigkeit

# Optional: veröffentlichte Images aus der GitHub Container Registry statt lokal gebauter Images nutzen.
# Mit Tag; <owner> ist der GitHub-Benutzer oder die Organisation, der das Repo gehört. Dann holen mit
# "docker compose --profile record pull" (oder "make pull recorder") und starten ohne --build ("make start recorder"). Mehr: docs/betrieb.md
# SWITCHER_EDITOR_IMAGE=ghcr.io/<owner>/settings-switcher-editor:latest
# SWITCHER_RECORDER_IMAGE=ghcr.io/<owner>/settings-switcher-recorder:latest
