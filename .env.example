# Nur für docker compose (Profil-Editor und Live-Recorder). Kopieren nach .env, chmod 600.
# Token erzeugen:  openssl rand -hex 24
EDITOR_TOKEN=

# Host-UID/GID, damit der Editor in ./profiles schreiben darf (id -u / id -g)
SS_UID=1000
SS_GID=1000

# Standard: nur lokal erreichbar. Für Zugriff aus dem LAN lieber Reverse Proxy mit TLS davorsetzen
# und den Hostnamen unten eintragen. Das Token geht sonst im Klartext über das Netz.
# EDITOR_BIND=127.0.0.1
# EDITOR_PORT=8080
# EDITOR_ALLOWED_HOSTS=localhost,127.0.0.1

# Nur für den Live-Recorder (docker compose --profile record): welche Hosts der Browser erreichen darf.
# Gleicher Wert wie in runner.env. Zugangsdaten gehören hier NICHT hinein.
SS_ALLOWED_HOSTS=192.168.178.1
# SS_IGNORE_HTTPS_ERRORS=0    # 1 nur bei https:// mit dem Fritzbox-Zertifikat
# REC_MAX_SECONDS=600         # harte Obergrenze einer Aufnahme
# REC_IDLE_SECONDS=180        # Aufnahme endet nach so langer Untätigkeit
